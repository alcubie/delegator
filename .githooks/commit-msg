#!/usr/bin/env python3
# Wrap commit bodies at 72 columns, leaving room for git log indentation.
# Preserve short paragraphs, lists, and indented blocks because their line
# breaks may be meaningful. Warn about long subjects without changing them or
# rejecting the commit.
import re
import sys
import textwrap

WIDTH = 72
SUBJECT = 50

LIST = re.compile(r"^\s*(?:[-*+]\s|\d+[.)]\s)")


def reflow(paragraph):
    lines = paragraph.split("\n")
    if all(len(line) <= WIDTH for line in lines):
        return paragraph
    if any(LIST.match(line) or line.startswith((" ", "\t")) for line in lines):
        return paragraph
    return "\n".join(
        textwrap.wrap(
            " ".join(line.strip() for line in lines),
            width=WIDTH,
            break_long_words=False,
            break_on_hyphens=False,
        )
    )


def main(path):
    with open(path, encoding="utf-8") as f:
        text = f.read()

    keep = [ln for ln in text.split("\n") if not ln.startswith("#")]
    subject, _, body = "\n".join(keep).partition("\n")

    if len(subject) > SUBJECT:
        print(
            f"commit-msg: the subject is {len(subject)} characters, over {SUBJECT}",
            file=sys.stderr,
        )

    paragraphs = re.split(r"\n\s*\n", body.strip("\n"))
    wrapped = "\n\n".join(reflow(p) for p in paragraphs if p.strip())

    out = subject if not wrapped else subject + "\n\n" + wrapped
    with open(path, "w", encoding="utf-8") as f:
        f.write(out + "\n")


main(sys.argv[1])
