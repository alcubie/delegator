%% dg init workflow
%% Without --agent, both input and output must be attached to a terminal.
%% Custom agents are registered separately with dg agents add.
flowchart TD
    START["01. dg init"] --> FLAG{"02. --agent supplied?"}

    FLAG -->|Yes| DISCOVER_SCRIPTED["03. Show current default<br/>Discover runnable registered agents<br/>and supported base CLIs"]
    DISCOVER_SCRIPTED --> FLAG_ADAPTER{"04. Selected discovered agent needs an<br/>Agent Client Protocol (ACP) command<br/>and init is interactive?"}
    FLAG_ADAPTER -->|Yes| ADAPTER_START
    FLAG_ADAPTER -->|No| SET_DEFAULT["05. Validate agent command<br/>Save as default"]

    FLAG -->|No| REQUIRE_TERMINAL["06. Require an interactive terminal<br/>otherwise return guidance to use --agent"]
    REQUIRE_TERMINAL --> DISCOVER_GUIDED["07. Show current default<br/>Discover runnable registered agents<br/>and supported base CLIs"]
    DISCOVER_GUIDED --> FOUND{"08. Any supported agents found?"}
    FOUND -->|No| NO_AGENTS["09. Report no supported agent<br/>Show dg agents add command"]
    NO_AGENTS --> INCOMPLETE["10. Setup incomplete"]
    FOUND -->|Yes| CHOOSER["11. Choose a detected agent by number"]
    CHOOSER -->|Cancel| KEEP_CURRENT{"12. Current default is among<br/>the ready choices?"}
    KEEP_CURRENT -->|Yes| COMPLETE
    KEEP_CURRENT -->|No| INCOMPLETE
    CHOOSER -->|Detected agent| CHOICE_ADAPTER{"13. Agent Client Protocol (ACP)<br/>command missing?"}
    CHOICE_ADAPTER -->|No| SET_DEFAULT
    CHOICE_ADAPTER -->|Yes| ADAPTER_START

    subgraph ADAPTER["Missing ACP command"]
        ADAPTER_START["14. Explain why ACP is required<br/>Report missing command<br/>Offer npm install"] --> INSTALL{"15. Install?"}
        INSTALL -->|Yes| RUN_INSTALL["16. Run fixed npm package install"]
        RUN_INSTALL --> INSTALL_OK{"17. Install command succeeded?"}
        INSTALL_OK -->|No| ERROR["18. Return error"]
        INSTALL_OK -->|Yes| ON_PATH{"19. ACP command now on PATH?"}
        ON_PATH -->|Yes| ADAPTER_READY["20. ACP command ready"]
        ON_PATH -->|No| MANUAL_PATH["21. Prompt for ACP command<br/>or absolute path"]
        INSTALL -->|No| MANUAL_PATH
        MANUAL_PATH --> PATH_GIVEN{"22. Path supplied?"}
        PATH_GIVEN -->|No| ADAPTER_CANCEL["23. Adapter not configured"]
        PATH_GIVEN -->|Yes| PATH_VALID{"24. Executable found?"}
        PATH_VALID -->|No| ERROR
        PATH_VALID -->|Yes| SAVE_ADAPTER["25. Save ACP command"]
        SAVE_ADAPTER --> ADAPTER_READY
    end
    ADAPTER_CANCEL --> INCOMPLETE
    ADAPTER_READY --> SET_DEFAULT

    SET_DEFAULT --> SET_OK{"26. Agent is registered<br/>and executable?"}
    SET_OK -->|No| ERROR
    SET_OK -->|Yes| COMPLETE["27. Setup complete<br/>Show default agent<br/>Show usage and next steps"]
