{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Delegator analytics v1 request",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "consent_notice_version": {
      "type": "integer",
      "const": 1
    },
    "instance_id": {
      "$ref": "#/$defs/uuid"
    },
    "machine_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "consent_started_at": {
      "$ref": "#/$defs/timestamp"
    },
    "generated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "version": {
      "type": "string",
      "pattern": "^(development|(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8}))$"
    },
    "os": {
      "enum": [
        "linux",
        "darwin",
        "windows",
        "other"
      ]
    },
    "installation": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "first_consent_at": {
              "$ref": "#/$defs/timestamp"
            }
          },
          "required": [
            "first_consent_at"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "daily": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "from": {
              "$ref": "#/$defs/timestamp"
            },
            "through": {
              "$ref": "#/$defs/timestamp"
            },
            "days": {
              "type": "array",
              "minItems": 1,
              "maxItems": 90,
              "items": {
                "$ref": "#/$defs/day"
              }
            },
            "settings": {
              "$ref": "#/$defs/settings"
            }
          },
          "required": [
            "from",
            "through",
            "days",
            "settings"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "consent_notice_version",
    "instance_id",
    "machine_id",
    "consent_started_at",
    "generated_at",
    "version",
    "os",
    "installation",
    "daily"
  ],
  "additionalProperties": false,
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{9}Z$",
      "format": "date-time"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "family": {
      "enum": [
        "claude",
        "codex",
        "gemini",
        "opencode",
        "goose",
        "github-copilot",
        "cursor",
        "pi",
        "custom"
      ]
    },
    "settings": {
      "type": "object",
      "properties": {
        "runs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "max_runs_per_project": {
          "$ref": "#/$defs/count"
        },
        "timeout_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "done_hours": {
          "$ref": "#/$defs/count"
        },
        "default_agent": {
          "anyOf": [
            {
              "$ref": "#/$defs/family"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "runs",
        "max_runs_per_project",
        "timeout_minutes",
        "done_hours",
        "default_agent"
      ],
      "additionalProperties": false
    },
    "day": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "format": "date"
        },
        "tickets_created": {
          "$ref": "#/$defs/count"
        },
        "tickets_first_ready": {
          "$ref": "#/$defs/count"
        },
        "tickets_accepted": {
          "$ref": "#/$defs/count"
        },
        "tickets_cancelled": {
          "$ref": "#/$defs/count"
        },
        "runs_started": {
          "$ref": "#/$defs/count"
        },
        "runs_ended": {
          "$ref": "#/$defs/count"
        },
        "runs_ended_unsuccessfully": {
          "$ref": "#/$defs/count"
        },
        "runs_started_by_agent": {
          "type": "object",
          "properties": {
            "claude": {
              "$ref": "#/$defs/count"
            },
            "codex": {
              "$ref": "#/$defs/count"
            },
            "gemini": {
              "$ref": "#/$defs/count"
            },
            "opencode": {
              "$ref": "#/$defs/count"
            },
            "goose": {
              "$ref": "#/$defs/count"
            },
            "github-copilot": {
              "$ref": "#/$defs/count"
            },
            "cursor": {
              "$ref": "#/$defs/count"
            },
            "pi": {
              "$ref": "#/$defs/count"
            },
            "custom": {
              "$ref": "#/$defs/count"
            }
          },
          "required": [
            "claude",
            "codex",
            "gemini",
            "opencode",
            "goose",
            "github-copilot",
            "cursor",
            "pi",
            "custom"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "date",
        "tickets_created",
        "tickets_first_ready",
        "tickets_accepted",
        "tickets_cancelled",
        "runs_started",
        "runs_ended",
        "runs_ended_unsuccessfully",
        "runs_started_by_agent"
      ],
      "additionalProperties": false
    }
  }
}
