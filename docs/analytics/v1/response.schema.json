{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Delegator analytics v1 response",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{9}Z$",
      "format": "date-time"
    }
  },
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "status": {
          "const": "accepted"
        },
        "instance_id": {
          "$ref": "#/$defs/uuid"
        },
        "consent_started_at": {
          "$ref": "#/$defs/timestamp"
        },
        "generated_at": {
          "$ref": "#/$defs/timestamp"
        },
        "installation_acknowledged": {
          "type": "boolean"
        },
        "reported_through": {
          "anyOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "status",
        "instance_id",
        "consent_started_at",
        "generated_at",
        "installation_acknowledged",
        "reported_through"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "error": {
          "enum": [
            "invalid_json",
            "request_too_large",
            "unsupported_media_type",
            "unsupported_version",
            "invalid_report",
            "identity_revoked",
            "rate_limited",
            "unavailable"
          ]
        }
      },
      "required": [
        "schema_version",
        "error"
      ],
      "additionalProperties": false
    }
  ]
}
